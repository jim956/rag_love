# ============ 对话模型（OpenAI 兼容接口） ============
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://xxx.maas.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=deepseek-v4.1-flash-1017

# ============ 向量化与重排（SiliconFlow） ============
SF_API_KEY=
SF_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ============ Milvus 检索 ============
MILVUS_URI=http://127.0.0.1:19530
MILVUS_DATABASE=rag_love
MILVUS_USER=root
MILVUS_PASSWORD=
MILVUS_COLLECTION=xxx
MILVUS_DENSE_FIELD=float_vector
MILVUS_SPARSE_FIELD=sparse_vector
# Milvus 中为 SiliconFlow 配置的凭据名称；也可改用环境变量 SILICONFLOW_API_KEY
MILVUS_RERANK_CREDENTIAL=siliconflow_apikey
SEARCH_LIMIT=10

# ============ LangGraph 检查点（PostgreSQL） ============
POSTGRES_URI=postgresql://postgres:postgres@127.0.0.1:5432/rag_love
POSTGRES_POOL_MAX_SIZE=10

# ============ Web 服务 ============
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============ 日志 ============
# DEBUG 会额外打印每次模型调用的完整输入（系统提示词 + 历史消息）
LOG_LEVEL=INFO
# 是否输出用户消息、AI 回复和工具入参/返回（包含聊天原文，隐私敏感时可置为 false）
LOG_MESSAGE_CONTENT=true